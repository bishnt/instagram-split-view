{
  "manifest_version": 3,
  "name": "Instagram Split View",
  "version": "1.1.0",
  "description": "Keeps only your Instagram Home feed and DMs, side by side in one tab (50/50). Everything else is removed and blocked, including by URL.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://www.instagram.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "block_other_routes", "enabled": true, "path": "rules.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
